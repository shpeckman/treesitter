# scripts/model/collect.cr

require "json"
require "./corpus_file"
require "./fetch"
require "./manifest"
require "./sources"
require "./verify"

module ModelBuild
  # A verified snippet: its language, its text and the unit it came from (a corpus case, an example file or a source
  # repository), so splits never put pieces of one unit on both sides.
  record Sample, language : String, text : String, group : String do
    include JSON::Serializable
  end

  # What one grammar's collection found and kept.
  class Tally
    include JSON::Serializable

    property cases      = 0
    property files      = 0
    property candidates = 0
    property duplicates = 0
    property rejected   = 0
    property timeouts   = 0
    property windows    = 0
    property kept       = 0
    property repos      = Set(String).new
    property note : String?

    def initialize
    end
  end

  # Turns the fetched corpora, examples and real-code sources into verified, deduplicated samples. Memory stays
  # bounded: each language keeps at most `budget` candidates, a uniform random sample of everything offered
  # (reservoir sampling), and duplicates are recognised by a 64-bit hash, not by keeping the text.
  class Collector
    WINDOW_LINES   = 40
    FILE_WINDOWS   = 20
    FILES_PER_REPO = 40
    MAX_FILE       = 1_000_000
    LONG_LINE      = 400
    MAX_ERROR      = {corpus: 0.0, file: 0.1, window: 0.3}
    COMMENT        = {"//", "#", "/*", "*", "--", ";", "%", "<!--", "(*", "{-", "\"\"\"", "'"}
    LICENSE        = /copyright|licen[cs]e|spdx/i
    GENERATED      = /@generated|do not edit|auto-?generated|generated by|automatically generated/i
    SETTINGS       = {WINDOW_LINES, FILE_WINDOWS, FILES_PER_REPO, MAX_FILE, LONG_LINE, MAX_ERROR, Verifier::PARSE_TIMEOUT, COMMENT, LICENSE.source, GENERATED.source}

    getter tallies : Hash(String, Tally)

    @installed = {} of String => Bool
    @seen      = Hash(String, Set(UInt64)).new { |hash, key| hash[key] = Set(UInt64).new }
    @reservoir = Hash(String, Array({String, String, Float64})).new { |hash, key| hash[key] = [] of {String, String, Float64} }
    @per_repo  = Hash({String, String}, Int32).new(0)

    def initialize(@grammars : Array(Grammar), @budget : Int32, @rng : Random)
      @tallies = @grammars.to_h { |grammar| {grammar.name, Tally.new} }
    end

    def grammars(root : String) : Nil
      @grammars.each do |grammar|
        next unless installed?(grammar.name)
        checkout = Fetch.directory(root, grammar.repo)
        tally    = @tallies[grammar.name]
        files(checkout, grammar.corpus).each do |path, relative|
          CorpusFile.parse(read(path) || next).each_with_index do |test, index|
            next if test.error
            next unless test.languages.empty? || test.languages.includes?(grammar.name)
            tally.cases += 1
            pieces(test.input, MAX_ERROR[:corpus]).each { |(text, limit)| offer(grammar.name, text, "#{grammar.repo}/#{relative}##{index}", limit) }
          end
        end
        files(checkout, grammar.examples).each do |path, relative|
          text = read(path) || next
          pieces(strip_license(text), MAX_ERROR[:file]).each { |(piece, limit)| offer(grammar.name, piece, "#{grammar.repo}/#{relative}", limit) }
        end
      end
    end

    def sources(sources : Array(Source), extensions : Extensions, root : String) : Nil
      sources.each do |source|
        checkout = Fetch.directory(root, source.repo)
        next unless Dir.exists?(checkout)
        found = Hash(String, Array(String)).new { |hash, key| hash[key] = [] of String }
        files(checkout, ["."]).each do |path, relative|
          next if relative.split('/').any? { |segment| Fetch::VENDORED.includes?(segment) }
          language = extensions.lookup(File.basename(relative)) || next
          found[language] << path if installed?(language)
        end
        found.each do |language, paths|
          tally = @tallies[language]
          paths.shuffle(@rng).each do |path|
            break if @per_repo[{language, source.repo}] >= FILES_PER_REPO
            text = read(path) || next
            next if generated?(text)
            tally.files += 1
            tally.repos << source.repo
            @per_repo[{language, source.repo}] += 1
            pieces(strip_license(text), MAX_ERROR[:file]).each { |(piece, limit)| offer(language, piece, "repo:#{source.repo}", limit) }
          end
        end
      end
    end

    # Verifies the kept candidates through *verifier*, parsing each with its own grammar in a worker process, and
    # returns the samples within `MAX_ERROR`; a candidate whose parse times out or hangs the worker is dropped.
    def samples(verifier : Verifier) : Array(Sample)
      @reservoir.flat_map do |language, candidates|
        tally = @tallies[language]
        STDERR.puts "verify #{language}: #{candidates.size} candidates"
        candidates.compact_map do |(text, group, limit)|
          verdict = verifier.check(language, text)
          ratio   = verdict.ratio
          if ratio.nil?
            tally.timeouts += 1
            next
          end
          if ratio > limit
            tally.rejected += 1
            next
          end
          tally.windows += 1 if limit == MAX_ERROR[:window]
          tally.kept += 1
          Sample.new(language, text, group)
        end
      end
    end

    private def offer(language : String, text : String, group : String, limit : Float64) : Nil
      return if text.blank?
      tally = @tallies[language]
      unless @seen[language].add?(text.strip.gsub(/\s+/, " ").hash)
        tally.duplicates += 1
        return
      end
      tally.candidates += 1
      bucket = @reservoir[language]
      if bucket.size < @budget
        bucket << {text, group, limit}
      elsif (slot = @rng.rand(tally.candidates)) < @budget
        bucket[slot] = {text, group, limit}
      end
    end

    private def installed?(language : String) : Bool
      @installed.fetch(language) do
        found = !TreeSitter::Language.find(language).nil?
        @tallies[language].note = "grammar not installed" unless found
        @installed[language] = found
      end
    end

    private def files(checkout : String, directories : Array(String)) : Array({String, String})
      checkout = File.expand_path(checkout)
      directories.flat_map do |directory|
        base = File.expand_path(directory, checkout)
        Dir.glob(File.join(base, "**", "*"), match: File::MatchOptions::DotFiles).select { |path| File.file?(path) }.sort.map do |path|
          {path, Path[path].relative_to(checkout).to_s}
        end
      end
    end

    private def read(path : String) : String?
      return nil if File.size(path) > MAX_FILE
      text = File.read(path)
      text.valid_encoding? && !text.includes?('\0') ? text.gsub("\r\n", "\n") : nil
    end

    private def generated?(text : String) : Bool
      lines = text.lines
      lines.first(10).any? { |line| GENERATED.matches?(line) } || lines.any? { |line| line.bytesize > LONG_LINE }
    end

    private def pieces(text : String, whole : Float64) : Array({String, Float64})
      lines = text.lines(chomp: false)
      return [{text, whole}] if lines.size <= WINDOW_LINES
      Array.new((lines.size // 8).clamp(1, FILE_WINDOWS)) do
        size  = 1 + (@rng.rand ** 2 * (WINDOW_LINES - 1)).to_i
        start = @rng.rand(lines.size - size + 1)
        {lines[start, size].join.chomp, MAX_ERROR[:window]}
      end
    end

    private def strip_license(text : String) : String
      lines  = text.lines(chomp: false)
      header = lines.take_while { |line| line.blank? || COMMENT.any? { |prefix| line.lstrip.starts_with?(prefix) } }
      header.any? { |line| LICENSE.matches?(line) } ? lines[header.size..].join : text
    end
  end
end
