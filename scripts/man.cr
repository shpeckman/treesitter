# scripts/man.cr

require "html"
require "json"
require "option_parser"

# Man pages for a Crystal shard. `generate` renders `README.md` and the API doc comments (read through
# `crystal docs --format json`) as man(7) roff: one section 3 page per type and a section 7 overview.
# `install` and `uninstall` manage a copy of those pages in a manual directory. Standard library only, so the
# script also runs as a `postinstall` hook.
module ManPages
  # Name of this generator, written into every page it generates.
  GENERATOR = "scripts/man.cr"

  # Comment text that marks a generated page; only pages carrying it are replaced, removed or uninstalled.
  MARKER = "Generated by #{GENERATOR}"

  # Page name suffix after the section number (`Foo.3cr`), so the pages never shadow C library pages.
  SUFFIX = "cr"

  # Manual section of the type pages.
  TYPE_SECTION = "3"

  # Manual section of the overview page.
  OVERVIEW_SECTION = "7"

  # Raised for every failure reported to the user.
  class Error < Exception
  end

  # Type path without generic arguments: `Foo(K, V)::Bar(T)` becomes `Foo::Bar`.
  def self.base_name(full_name : String) : String
    name = full_name
    while (stripped = name.gsub(/\([^()]*\)/, "")) != name
      name = stripped
    end
    name
  end

  # Type names without the global `::` prefix the doc generator adds to some return types.
  def self.clean_type(text : String) : String
    text.gsub(/(\A|[\s(|,])::(?=[A-Z])/) { |_, md| md[1] }
  end

  # First sentence of the first paragraph of *markdown*, by the rule of the HTML doc generator.
  def self.summary(markdown : String?) : String
    paragraph = markdown.to_s.strip.split(/\n[ \t]*\n/, 2).first? || ""
    line = paragraph.gsub(/(?:\\|[ \t]*)\n[ \t]*/, " ")
    (dot = line =~ /\.(\s|\z)/) ? line[0..dot] : line
  end

  # Source location of a documented type.
  struct Location
    include JSON::Serializable

    getter filename : String?
  end

  # Reference to another type: a superclass, ancestor, namespace or related module.
  struct TypeRef
    include JSON::Serializable

    getter kind : String
    getter full_name : String
  end

  # Method or macro parameter; only its external name matters, to recognize generated members.
  struct Arg
    include JSON::Serializable

    getter external_name : String?
  end

  # Definition node of a member: the declared return type and the body.
  struct Definition
    include JSON::Serializable

    getter return_type : String?
    getter body : String?
  end

  # Constant or enum member.
  struct Constant
    include JSON::Serializable

    # Openings of macro expressions, which `crystal docs` leaves unexpanded.
    MACRO_STARTS = {"{{", "{%"}

    getter name : String
    getter doc : String?
    @value : String?

    # Value as written in the source; `nil` when unknown or an unexpanded macro expression.
    def value : String?
      value = @value
      value unless value && MACRO_STARTS.any? { |start| value.starts_with?(start) }
    end
  end

  # Constructor, method or macro.
  struct Member
    include JSON::Serializable

    # Members the compiler or `record` defines in every type; hidden unless someone documented them.
    BOILERPLATE = {"clone", "copy_with", "finalize"}

    # Bodies of the `new` overloads `JSON::Serializable` and `YAML::Serializable` define in every including type.
    SERIALIZER_BODIES = {"new_from_json_pull_parser(pull)", "new_from_yaml_node(ctx, node)"}

    ID_SUFFIX = /-(?:instance-method|class-method|macro|function)\z/

    getter html_id : String
    getter name : String
    getter doc : String?
    @[JSON::Field(key: "abstract")]
    getter? abstract_def : Bool = false
    getter args : Array(Arg) = [] of Arg
    getter args_string : String?
    @[JSON::Field(key: "def")]
    getter definition : Definition?

    # Whether the standard library or the compiler generated this member.
    def generated? : Bool
      (doc.nil? && BOILERPLATE.includes?(name)) ||
        args.any? { |arg| arg.external_name.try(&.starts_with?("__")) } ||
        SERIALIZER_BODIES.includes?(definition.try(&.body))
    end

    # Parameters and return type as declared, e.g. `(name : String) : Language`.
    def parameters : String
      ManPages.clean_type(args_string || return_type.try { |type| " : #{type}" } || "")
    end

    # `crystal docs` gives no parameter string for a member without parameters, and macro-generated getters
    # carry their return type only in the id (`name:Type-instance-method`).
    private def return_type : String?
      definition.try(&.return_type) || begin
        rest = HTML.unescape(html_id).lchop(name)
        rest.sub(ID_SUFFIX, "")[1..].presence if args.empty? && rest.starts_with?(':')
      end
    end
  end

  # A documented type; the program, the top level namespace, is one too.
  class TypeDoc
    include JSON::Serializable

    getter kind : String
    getter full_name : String
    @[JSON::Field(key: "abstract")]
    getter? abstract_type : Bool = false
    getter superclass : TypeRef?
    getter ancestors : Array(TypeRef) = [] of TypeRef
    getter locations : Array(Location) = [] of Location
    getter? program : Bool = false
    @[JSON::Field(key: "enum")]
    getter? enum_type : Bool = false
    @[JSON::Field(key: "alias")]
    getter? alias_type : Bool = false
    getter aliased : String?
    getter constants : Array(Constant) = [] of Constant
    getter included_modules : Array(TypeRef) = [] of TypeRef
    getter extended_modules : Array(TypeRef) = [] of TypeRef
    getter subclasses : Array(TypeRef) = [] of TypeRef
    getter including_types : Array(TypeRef) = [] of TypeRef
    getter namespace : TypeRef?
    getter doc : String?
    getter constructors : Array(Member) = [] of Member
    getter class_methods : Array(Member) = [] of Member
    getter instance_methods : Array(Member) = [] of Member
    getter macros : Array(Member) = [] of Member
    getter types : Array(TypeDoc) = [] of TypeDoc

    # Drops generated members, and the `Kind#member?` predicates every enum gets, right after parsing.
    protected def after_initialize : Nil
      {@constructors, @class_methods, @instance_methods, @macros}.each &.reject!(&.generated?)
      return unless enum_type?
      predicates = constants.map { |constant| "#{constant.name.underscore}?" }
      @instance_methods.reject! { |member| member.args.empty? && predicates.includes?(member.name) }
    end

    def base_name : String
      ManPages.base_name(full_name)
    end

    def lib? : Bool
      kind == "lib"
    end

    # Related type lists with their section titles, in page order.
    def relations : Array({String, Array(TypeRef)})
      [
        {"INCLUDED MODULES", included_modules},
        {"EXTENDED MODULES", extended_modules},
        {"DIRECT KNOWN SUBCLASSES", subclasses},
        {"DIRECT INCLUDING TYPES", including_types},
      ]
    end

    # The doc comments of the type and of everything it declares.
    def docs : Array(String)
      list = [doc].compact
      constants.each { |constant| constant.doc.try { |text| list << text } }
      {constructors, class_methods, instance_methods, macros}.each do |members|
        members.each { |member| member.doc.try { |text| list << text } }
      end
      list
    end

    # Whether the top level namespace declares anything worth a page.
    def toplevel_content? : Bool
      !(class_methods.empty? && macros.empty? && constants.empty?)
    end
  end

  # Root of the `crystal docs --format json` output.
  class Project
    include JSON::Serializable

    getter repository_name : String
    getter body : String
    getter program : TypeDoc
  end

  # Runs the compiler's doc tool.
  module Source
    COMMAND = "crystal"

    # The documentation index of the project in *root*; compiler diagnostics go to stderr.
    def self.load(root : String) : Project
      output = IO::Memory.new
      status = Process.run(COMMAND, {"docs", "--format", "json"}, chdir: root, output: output, error: Process::Redirect::Inherit)
      raise Error.new("`#{COMMAND} docs` failed with exit code #{status.exit_code}") unless status.success?
      Project.from_json(output.rewind)
    rescue ex : File::Error
      raise Error.new("cannot run `#{COMMAND}`: #{ex.message}")
    end
  end

  # The shard being documented: its root, name, version, and the `require` that loads each source file.
  class Shard
    REQUIRE      = /\A\s*require\s+"(\.\.?\/[^"]+)"/
    VERSION_LINE = /\Aversion:\s*["']?([^\s"']+)/

    getter root : String
    getter name : String
    getter version : String?

    # Source file → {entry order, require path}; the main entry (`src/<name>.cr`) comes first.
    @entries = {} of String => {Int32, String}

    def initialize(@root : String, @name : String)
      manifest = File.join(root, "shard.yml")
      @version = File.read_lines(manifest).compact_map(&.match(VERSION_LINE).try(&.[1])).first? if File.file?(manifest)
      main = File.join(root, "src", "#{name}.cr")
      entries = Dir.glob(File.join(root, "src", "*.cr")).sort_by { |path| {path == main ? 0 : 1, path} }
      entries.each_with_index do |entry, order|
        stem = File.basename(entry, ".cr")
        visit(entry, {order, stem == name ? name : "#{name}/#{stem}"})
      end
    end

    # The `require` that loads *type*, from the first entry file that reaches one of its source files.
    def require_path(type : TypeDoc) : String?
      found = type.locations.compact_map { |location| location.filename.try { |file| @entries[File.expand_path(file, root)]? } }
      found.min_by?(&.[0]).try(&.[1])
    end

    # *text* with the shard's absolute path made relative, so pages built on any machine are identical.
    def relative(text : String) : String
      text.gsub("#{root}/", "").gsub(root, ".")
    end

    private def visit(file : String, entry : {Int32, String}) : Nil
      return if @entries.has_key?(file)
      @entries[file] = entry
      File.each_line(file) do |line|
        next unless md = line.match(REQUIRE)
        targets(File.expand_path(md[1], File.dirname(file))).each { |target| visit(target, entry) }
      end
    end

    # Files a relative require loads, by the compiler's lookup rules.
    private def targets(path : String) : Array(String)
      return Dir.glob(File.join(path.rchop("/**"), "**", "*.cr")).sort if path.ends_with?("/**")
      return Dir.glob(File.join(path.rchop("/*"), "*.cr")).sort if path.ends_with?("/*")
      candidates = path.ends_with?(".cr") ? [path] : ["#{path}.cr", File.join(path, "#{File.basename(path)}.cr")]
      candidates.select { |candidate| File.file?(candidate) }.first(1)
    end
  end

  # Lookup tables over the documented types.
  class Index
    TYPE_PATH = /\A((?:::)?[A-Z]\w*(?:::[A-Z]\w*)*)(?:[#.(]|\z)/
    CODE_SPAN = /(?<!`)(`+)(?!`)(.+?)(?<!`)\1(?!`)/m

    getter project : Project
    getter types = [] of TypeDoc

    @by_name = {} of String => TypeDoc

    def initialize(@project : Project)
      program = project.program
      @types << program if program.toplevel_content?
      collect(program)
    end

    # The documented type named *full_name*, generic arguments ignored.
    def []?(full_name : String) : TypeDoc?
      @by_name[ManPages.base_name(full_name)]?
    end

    # Resolves *name* as Crystal does: relative to *context*, then to each enclosing namespace.
    def lookup(context : TypeDoc, name : String) : TypeDoc?
      name = ManPages.base_name(name)
      return @by_name[name.lchop("::")]? if name.starts_with?("::")
      scope = context.program? ? nil : context.base_name
      loop do
        found = @by_name[scope ? "#{scope}::#{name}" : name]?
        return found if found
        return nil unless scope
        scope = scope.rpartition("::")[0].presence
      end
    end

    # Types the docs of *type* name in code spans: `Tree`, `Tree#edit`, `Language.load`, `Language::MIN_ABI`.
    def referenced(type : TypeDoc) : Array(TypeDoc)
      found = [] of TypeDoc
      type.docs.each do |doc|
        doc.scan(CODE_SPAN) do |md|
          next unless path = md[2].strip.match(TYPE_PATH).try(&.[1])
          parent = path.rpartition("::")[0].presence
          target = lookup(type, path) || parent.try { |name| lookup(type, name) }
          found << target if target
        end
      end
      found
    end

    private def collect(type : TypeDoc) : Nil
      type.types.each do |nested|
        @by_name[nested.base_name] = nested
        @types << nested
        collect(nested)
      end
    end
  end

  # roff escaping for man(7) output.
  module Roff
    # Indentation of nested blocks, in ens.
    INDENT = 4

    # Characters roff reads as escapes or typesets as typographic glyphs, with their literal spellings.
    GLYPHS = {'\\' => "\\e", '-' => "\\-", '\'' => "\\(aq", '`' => "\\(ga", '~' => "\\(ti", '^' => "\\(ha"}

    # Writes *char* so roff prints it literally; non-ASCII characters become `\[uXXXX]`, valid in any encoding.
    def self.escape(char : Char, io : IO) : Nil
      if glyph = GLYPHS[char]?
        io << glyph
      elsif char.ascii?
        io << char
      else
        io << "\\[u"
        char.ord.to_s(io, 16, precision: 4, upcase: true)
        io << ']'
      end
    end

    def self.escape(text : String, io : IO) : Nil
      text.each_char { |char| escape(char, io) }
    end

    def self.escape(text : String) : String
      String.build { |io| escape(text, io) }
    end

    # Double-quoted macro argument.
    def self.quote(text : String) : String
      %("#{escape(text).gsub('"', "\\(dq")}")
    end

    def self.bold(text : String) : String
      "\\fB#{escape(text)}\\fR"
    end

    # Writes *text* as literal lines for a no-fill display; a line starting with a dot is never read as a request.
    def self.lines(text : String, io : IO) : Nil
      text.each_line do |line|
        io << "\\&" if line.starts_with?('.')
        escape(line, io)
        io << '\n'
      end
    end
  end

  # Converts CommonMark, with GitHub tables, to man(7) roff.
  module Markdown
    abstract struct Block
    end

    struct Heading < Block
      getter level : Int32
      getter text : String

      def initialize(@level : Int32, @text : String)
      end
    end

    struct Paragraph < Block
      getter text : String

      def initialize(@text : String)
      end
    end

    struct Code < Block
      getter text : String

      def initialize(@text : String)
      end
    end

    struct List < Block
      getter? ordered : Bool
      getter start : Int32
      getter items : Array(Array(Block))

      def initialize(@ordered : Bool, @start : Int32, @items : Array(Array(Block)))
      end
    end

    struct Quote < Block
      getter blocks : Array(Block)

      def initialize(@blocks : Array(Block))
      end
    end

    struct Table < Block
      getter header : Array(String)
      getter rows : Array(Array(String))

      def initialize(@header : Array(String), @rows : Array(Array(String)))
      end
    end

    struct Rule < Block
    end

    # The blocks of *text*; `:showdoc:` and surrounding whitespace are dropped.
    def self.parse(text : String?) : Array(Block)
      Parser.parse(text.to_s.strip.lchop(":showdoc:").strip)
    end

    # Block structure of CommonMark text. Inline markup stays in the text and is handled by `Inline`.
    class Parser
      FENCE   = /\A( {0,3})(`{3,}|~{3,})/
      HEADING = /\A {0,3}(\#{1,6})(?:[ \t]+(.*?))?(?:[ \t]+\#+)?[ \t]*\z/
      SETEXT  = /\A {0,3}(=+|-+)[ \t]*\z/
      RULE    = /\A {0,3}([-*_])(?:[ \t]*\1){2,}[ \t]*\z/
      QUOTE   = /\A {0,3}> ?(.*)\z/
      ITEM    = /\A( {0,3})([-*+]|\d{1,9}[.)])(?:( +)(.*))?\z/
      ALIGN   = /\A[ \t]*[|:\-][|:\- \t]*\z/
      CODE    = "    "

      def self.parse(text : String) : Array(Block)
        new(text.lines.map { |line| expand_tabs(line) }).blocks
      end

      # Tabs as spaces to the next multiple of four columns.
      def self.expand_tabs(line : String) : String
        return line unless line.includes?('\t')
        String.build do |io|
          column = 0
          line.each_char do |char|
            if char == '\t'
              spaces = 4 - column % 4
              spaces.times { io << ' ' }
              column += spaces
            else
              io << char
              column += 1
            end
          end
        end
      end

      def initialize(@lines : Array(String))
        @index = 0
      end

      def blocks : Array(Block)
        blocks = [] of Block
        while line = @lines[@index]?
          if line.blank?
            @index += 1
          else
            blocks << block(line)
          end
        end
        blocks
      end

      private def block(line : String) : Block
        if md = line.match(FENCE)
          fenced(md[1].size, md[2])
        elsif md = line.match(HEADING)
          @index += 1
          Heading.new(md[1].size, md[2]? || "")
        elsif line.matches?(RULE)
          @index += 1
          Rule.new
        elsif table?(line)
          table
        elsif line.matches?(QUOTE)
          quote
        elsif md = line.match(ITEM)
          list(md)
        elsif line.starts_with?(CODE)
          indented
        else
          paragraph
        end
      end

      private def fenced(indent : Int32, fence : String) : Code
        closing = Regex.new("\\A {0,3}#{Regex.escape(fence[0].to_s)}{#{fence.size},}[ \\t]*\\z")
        lines = [] of String
        @index += 1
        while line = @lines[@index]?
          @index += 1
          break if line.matches?(closing)
          lines << line[Math.min(indent, indentation(line))..]
        end
        Code.new(lines.join('\n'))
      end

      private def indented : Code
        lines = [] of String
        while line = @lines[@index]?
          if line.starts_with?(CODE)
            lines << line[CODE.size..]
          elsif line.blank?
            lines << ""
          else
            break
          end
          @index += 1
        end
        while lines.last?.try(&.blank?)
          lines.pop
        end
        Code.new(lines.join('\n'))
      end

      private def table?(line : String) : Bool
        return false unless line.includes?('|')
        align = @lines[@index + 1]?
        !!align && align.includes?('|') && align.includes?('-') && align.matches?(ALIGN)
      end

      private def table : Table
        header = cells(@lines[@index])
        @index += 2
        rows = [] of Array(String)
        while (line = @lines[@index]?) && !line.blank? && line.includes?('|')
          row = cells(line)
          rows << Array.new(header.size) { |column| row[column]? || "" }
          @index += 1
        end
        Table.new(header, rows)
      end

      # Cells split at unescaped pipes; `\|` becomes a plain pipe, even inside code spans.
      private def cells(line : String) : Array(String)
        line = line.strip
        cells = [] of String
        cell = String::Builder.new
        escaped = false
        line.each_char do |char|
          if escaped
            cell << '\\' unless char == '|'
            cell << char
            escaped = false
          elsif char == '\\'
            escaped = true
          elsif char == '|'
            cells << cell.to_s.strip
            cell = String::Builder.new
          else
            cell << char
          end
        end
        cell << '\\' if escaped
        cells << cell.to_s.strip
        cells.shift if line.starts_with?('|')
        cells.pop if line.ends_with?('|') && !line.ends_with?("\\|")
        cells
      end

      private def quote : Quote
        lines = [] of String
        while (line = @lines[@index]?) && (md = line.match(QUOTE))
          lines << md[1]
          @index += 1
        end
        Quote.new(Parser.new(lines).blocks)
      end

      private def list(first : Regex::MatchData) : List
        marker = first[2]
        ordered = marker[0].ascii_number?
        start = ordered ? marker.rchop.to_i : 1
        items = [] of Array(Block)
        while (line = @lines[@index]?) && !line.matches?(RULE) && (md = line.match(ITEM)) &&
              md[2][-1] == marker[-1] && md[2][0].ascii_number? == ordered
          items << Parser.new(item_lines(md)).blocks
        end
        List.new(ordered, start, items)
      end

      # The lines of one list item with its content indentation removed.
      private def item_lines(md : Regex::MatchData) : Array(String)
        spaces = md[3]?.try(&.size) || 1
        content = md[4]? || ""
        if spaces > 4
          content = " " * (spaces - 1) + content
          spaces = 1
        end
        width = md[1].size + md[2].size + spaces
        lines = [content]
        @index += 1
        while line = @lines[@index]?
          if line.blank?
            following = @lines[(@index + 1)..].find { |rest| !rest.blank? }
            break unless following && indentation(following) >= width
            lines << ""
          elsif indentation(line) >= width
            lines << line[width..]
          elsif !lines.last.blank? && !interrupts?(line) && !line.matches?(ITEM)
            lines << line.lstrip
          else
            break
          end
          @index += 1
        end
        lines
      end

      private def paragraph : Block
        lines = [@lines[@index].lstrip]
        @index += 1
        while (line = @lines[@index]?) && !line.blank?
          if md = line.match(SETEXT)
            @index += 1
            return Heading.new(md[1][0] == '=' ? 1 : 2, lines.join('\n').strip)
          end
          break if interrupts?(line)
          lines << line.lstrip
          @index += 1
        end
        Paragraph.new(lines.join('\n'))
      end

      # Whether *line* starts a block that ends a paragraph. A list item does so only when it has content and,
      # if ordered, starts at 1.
      private def interrupts?(line : String) : Bool
        return true if {FENCE, HEADING, RULE, QUOTE}.any? { |pattern| line.matches?(pattern) }
        return false unless (md = line.match(ITEM)) && (text = md[4]?) && !text.blank?
        !md[2][0].ascii_number? || md[2].rchop == "1"
      end

      private def indentation(line : String) : Int32
        line.size - line.lstrip(' ').size
      end
    end

    # Renders the inline markup of one block: code spans, emphasis, links, autolinks, escapes and hard breaks.
    class Inline
      FONTS = {
        {false, false} => "\\fR",
        {true, false}  => "\\fB",
        {false, true}  => "\\fI",
        {true, true}   => "\\f(BI",
      }

      # Delimiter run length → {bold, italic}.
      STRENGTH    = {1 => {0, 1}, 2 => {1, 0}, 3 => {1, 1}}
      PUNCTUATION = "!\"#$%&'()*+,-./:;<=>?@[\\]^_`{|}~"
      SCHEME      = /\A[A-Za-z][A-Za-z0-9+.\-]{1,31}:[^\s<>]*\z/

      # Roff for *text*. *bold* sets the base font, *urls* appends external link targets, *upcase* capitalizes
      # everything outside code spans.
      def self.render(text : String, *, bold : Bool = false, urls : Bool = true, upcase : Bool = false) : String
        String.build do |io|
          io << FONTS[{true, false}] if bold
          inline = new(text, io, bold, urls, upcase)
          inline.run(0, inline.size)
          io << FONTS[{false, false}] if bold
        end
      end

      @bold : Int32
      @italic = 0
      @line_start = true

      def initialize(text : String, @io : IO, bold : Bool, @urls : Bool, @upcase : Bool)
        @chars = text.chars
        @bold = bold ? 1 : 0
      end

      def size : Int32
        @chars.size
      end

      def run(from : Int32, to : Int32) : Nil
        index = from
        while index < to
          index = step(index, to)
        end
      end

      private def step(index : Int32, to : Int32) : Int32
        case char = @chars[index]
        when '\\'      then escape_sequence(index, to)
        when '`'       then code_span(index, to)
        when '*', '_'  then emphasis(index, to)
        when '['       then link(index, to, false) || literal(char, index)
        when '!'       then (link(index + 1, to, true) if at?(index + 1, to, '[')) || literal(char, index)
        when '<'       then autolink(index, to) || literal(char, index)
        when ' '       then spaces(index, to)
        when '\n'      then newline(index + 1, to)
        else                literal(char, index)
        end
      end

      private def escape_sequence(index : Int32, to : Int32) : Int32
        if at?(index + 1, to, '\n')
          hard_break
          skip_indent(index + 2, to)
        elsif index + 1 < to && PUNCTUATION.includes?(@chars[index + 1])
          literal(@chars[index + 1], index + 1)
        else
          literal('\\', index)
        end
      end

      private def code_span(index : Int32, to : Int32) : Int32
        ticks = run_length(index, to, '`')
        unless close = closing_ticks(index + ticks, to, ticks)
          ticks.times { |offset| literal('`', index + offset) }
          return index + ticks
        end
        code = @chars[(index + ticks)...close].join.gsub('\n', ' ')
        code = code[1...-1] if code.size >= 2 && code.starts_with?(' ') && code.ends_with?(' ') && !code.blank?
        # `\%` before each word keeps code from being hyphenated.
        font(1, 0)
        @io << "\\%"
        code.each_char do |char|
          Roff.escape(char, @io)
          @io << "\\%" if char == ' '
        end
        font(-1, 0)
        close + ticks
      end

      private def emphasis(index : Int32, to : Int32) : Int32
        delimiter = @chars[index]
        length = run_length(index, to, delimiter)
        if opens?(index, length, to, delimiter)
          Math.min(length, 3).downto(1) do |width|
            next unless close = closing_delimiter(index + width, to, delimiter, width)
            bold, italic = STRENGTH[width]
            font(bold, italic)
            run(index + width, close)
            font(-bold, -italic)
            return close + width
          end
        end
        length.times { |offset| literal(delimiter, index + offset) }
        index + length
      end

      # A link or image starting at the `[` at *index*; `nil` when the text is not one.
      private def link(index : Int32, to : Int32, image : Bool) : Int32?
        return nil unless (close = closing_bracket(index, to)) && at?(close + 1, to, '(')
        return nil unless target = destination(close + 2, to)
        url, finish = target
        run(index + 1, close)
        external = url.includes?("://") || url.starts_with?("mailto:")
        if @urls && !image && external && @chars[(index + 1)...close].join != url
          emit(" <")
          Roff.escape(url, @io)
          emit(">")
        end
        finish
      end

      private def autolink(index : Int32, to : Int32) : Int32?
        finish = index + 1
        while finish < to && !@chars[finish].in?('>', '<', ' ', '\n')
          finish += 1
        end
        return nil unless at?(finish, to, '>')
        url = @chars[(index + 1)...finish].join
        return nil unless url.matches?(SCHEME)
        emit("")
        Roff.escape(url, @io)
        finish + 1
      end

      # Trailing spaces before a newline: two or more make a hard break.
      private def spaces(index : Int32, to : Int32) : Int32
        finish = index
        while at?(finish, to, ' ')
          finish += 1
        end
        return finish if finish == to
        return literal(' ', finish - 1) unless at?(finish, to, '\n')
        if finish - index >= 2
          hard_break
          skip_indent(finish + 1, to)
        else
          newline(finish + 1, to)
        end
      end

      private def newline(index : Int32, to : Int32) : Int32
        @io << '\n'
        @line_start = true
        skip_indent(index, to)
      end

      private def hard_break : Nil
        @io << "\n.br\n"
        @line_start = true
      end

      private def literal(char : Char, index : Int32) : Int32
        char = char.upcase if @upcase
        @io << "\\&" if @line_start && char == '.'
        @line_start = false
        Roff.escape(char, @io)
        index + 1
      end

      private def emit(text : String) : Nil
        @io << text
        @line_start = false
      end

      private def font(bold : Int32, italic : Int32) : Nil
        @bold += bold
        @italic += italic
        emit(FONTS[{@bold > 0, @italic > 0}])
      end

      private def opens?(index : Int32, length : Int32, to : Int32, delimiter : Char) : Bool
        after = index + length
        return false if after >= to || @chars[after].whitespace?
        delimiter != '_' || index == 0 || !@chars[index - 1].alphanumeric?
      end

      # Position of the run of exactly *width* delimiters closing an emphasis opened before *from*.
      private def closing_delimiter(from : Int32, to : Int32, delimiter : Char, width : Int32) : Int32?
        index = from
        while index < to
          char = @chars[index]
          if char == '\\'
            index += 2
          elsif char == '`'
            ticks = run_length(index, to, '`')
            index = (close = closing_ticks(index + ticks, to, ticks)) ? close + ticks : index + ticks
          elsif char == delimiter
            length = run_length(index, to, delimiter)
            after = index + length
            flanking = index > from && !@chars[index - 1].whitespace?
            word = delimiter == '_' && after < to && @chars[after].alphanumeric?
            return index if length == width && flanking && !word
            index = after
          else
            index += 1
          end
        end
      end

      private def closing_ticks(from : Int32, to : Int32, ticks : Int32) : Int32?
        index = from
        while index < to
          if @chars[index] == '`'
            length = run_length(index, to, '`')
            return index if length == ticks
            index += length
          else
            index += 1
          end
        end
      end

      private def closing_bracket(index : Int32, to : Int32) : Int32?
        depth = 0
        while index < to
          case @chars[index]
          when '\\'
            index += 1
          when '`'
            ticks = run_length(index, to, '`')
            index = ((close = closing_ticks(index + ticks, to, ticks)) ? close + ticks : index + ticks) - 1
          when '['
            depth += 1
          when ']'
            depth -= 1
            return index if depth == 0
          end
          index += 1
        end
      end

      # Link destination and the position after the closing parenthesis; an optional title is skipped.
      private def destination(index : Int32, to : Int32) : {String, Int32}?
        index = skip_space(index, to)
        start = index
        if at?(index, to, '<')
          while index < to && !@chars[index].in?('>', '\n')
            index += 1
          end
          return nil unless at?(index, to, '>')
          url = @chars[(start + 1)...index].join
          index += 1
        else
          depth = 0
          while index < to && !@chars[index].whitespace?
            char = @chars[index]
            break if char == ')' && depth == 0
            depth += 1 if char == '('
            depth -= 1 if char == ')'
            index += 1
          end
          url = @chars[start...index].join
        end
        index = skip_space(index, to)
        if index < to && (closer = {'"' => '"', '\'' => '\'', '(' => ')'}[@chars[index]]?)
          index += 1
          while index < to && @chars[index] != closer
            index += 1
          end
          index = skip_space(index + 1, to)
        end
        at?(index, to, ')') ? {url, index + 1} : nil
      end

      private def skip_space(index : Int32, to : Int32) : Int32
        while index < to && @chars[index].whitespace?
          index += 1
        end
        index
      end

      private def skip_indent(index : Int32, to : Int32) : Int32
        while index < to && @chars[index].in?(' ', '\t')
          index += 1
        end
        index
      end

      private def run_length(index : Int32, to : Int32, char : Char) : Int32
        length = 0
        while index + length < to && @chars[index + length] == char
          length += 1
        end
        length
      end

      private def at?(index : Int32, to : Int32, char : Char) : Bool
        index < to && @chars[index] == char
      end
    end

    # Writes blocks as roff. With *sections*, headings become `.SH` and `.SS` as on a page of their own;
    # otherwise, inside a page section, they become bold paragraphs.
    class Renderer
      # Roff macro for each heading level when the text is a whole page.
      SECTIONS = {1 => ".SH", 2 => ".SH", 3 => ".SS"}

      # Flag words that open a paragraph in Crystal doc comments, shown as bold labels.
      FLAG = /\A(BUG|DEPRECATED|EXPERIMENTAL|FIXME|NOTE|OPTIMIZE|TODO|WARNING)(?:\(([^)]*)\))?:?(?=\s|\z)/

      # Whether a table was written, which needs the `tbl` preprocessor.
      getter? tables = false

      def initialize(@io : IO, @sections : Bool = false)
      end

      def render(blocks : Array(Block)) : Nil
        blocks.each { |block| render(block) }
      end

      def render(block : Block) : Nil
        case block
        when Heading   then heading(block)
        when Paragraph then @io << ".PP\n"; paragraph(block)
        when Code      then code(block.text)
        when List      then list(block)
        when Quote     then indent { render(block.blocks) }
        when Table     then table(block)
        when Rule      then @io << ".PP\n\\(em\\(em\\(em\n"
        end
      end

      # A tagged paragraph: *head* is the roff that opens it (`.IP` or `.TP` and its tag), the first paragraph
      # of *blocks* continues on it and the remaining blocks keep its indentation.
      def item(head : String, blocks : Array(Block)) : Nil
        @io << head << '\n'
        rest = blocks
        if (first = blocks.first?).is_a?(Paragraph)
          paragraph(first)
          rest = blocks[1..]
        elsif blocks.empty?
          @io << "\\&\n"
        end
        return if rest.empty?
        @io << ".RS\n"
        render(rest)
        @io << ".RE\n"
      end

      private def heading(block : Heading) : Nil
        if @sections && (command = SECTIONS[block.level]?)
          @io << command << '\n' << Inline.render(block.text, upcase: command == ".SH") << '\n'
        else
          @io << ".PP\n" << Inline.render(block.text, bold: true) << '\n'
        end
      end

      private def paragraph(block : Paragraph) : Nil
        text = block.text
        if md = text.match(FLAG)
          @io << Roff.bold("#{md[1]}#{md[2]?.try { |detail| " (#{detail})" }}:") << ' '
          text = text[md.end..].lstrip
        end
        @io << Inline.render(text) << '\n'
      end

      private def code(text : String) : Nil
        @io << ".PP\n"
        indent do
          @io << ".EX\n"
          Roff.lines(text, @io)
          @io << ".EE\n"
        end
      end

      private def list(block : List) : Nil
        last = block.start + block.items.size - 1
        width = block.ordered? ? "#{last}.".size + 1 : 2
        block.items.each_with_index do |blocks, index|
          marker = block.ordered? ? "#{block.start + index}." : "\\(bu"
          item(".IP #{marker} #{width}", blocks)
        end
      end

      private def table(block : Table) : Nil
        @tables = true
        formats = Array.new(block.header.size - 1, "l") << "lx"
        @io << ".PP\n.TS\ntab(\t);\n" << formats.join(' ') << ".\n"
        row(block.header, true)
        @io << "_\n"
        block.rows.each { |cells| row(cells, false) }
        @io << ".TE\n"
      end

      private def row(cells : Array(String), header : Bool) : Nil
        cells.each_with_index do |cell, index|
          text = Inline.render(cell.gsub('\t', ' '), bold: header)
          @io << '\t' if index > 0
          @io << "T{\n" << (text.empty? ? "\\&" : text) << "\nT}"
        end
        @io << '\n'
      end

      private def indent(&) : Nil
        @io << ".RS " << Roff::INDENT << '\n'
        yield
        @io << ".RE\n"
      end
    end
  end

  # Lays out constant values for display.
  module Literal
    # Longest value shown in the constant's tag; longer ones get a display of their own.
    LIMIT = 60

    PAIRS = {'{' => '}', '[' => ']'}

    def self.inline?(value : String) : Bool
      value.size <= LIMIT && !value.includes?('\n')
    end

    # *value* with a long one-line hash, array or tuple literal split into one element per line.
    def self.layout(value : String) : String
      return value unless (open = value[0]?) && (close = PAIRS[open]?) && value.ends_with?(close) && !value.includes?('\n')
      parts = split(value[1...-1])
      return value if parts.size < 2
      String.build do |io|
        io << open << '\n'
        parts.each { |part| io << "  " << part << ",\n" }
        io << close
      end
    end

    # Elements separated by top-level commas, outside nested brackets and string or char literals.
    private def self.split(inner : String) : Array(String)
      parts = [] of String
      depth = 0
      quote = nil.as(Char?)
      escaped = false
      start = 0
      inner.each_char_with_index do |char, index|
        if quote
          if escaped
            escaped = false
          elsif char == '\\'
            escaped = true
          elsif char == quote
            quote = nil
          end
        else
          case char
          when '"', '\''     then quote = char
          when '{', '[', '(' then depth += 1
          when '}', ']', ')' then depth -= 1
          when ','
            next unless depth == 0
            parts << inner[start...index].strip
            start = index + 1
          end
        end
      end
      parts << inner[start..].strip
      parts.reject(&.empty?)
    end
  end

  # One generated page; the date is set when it is written.
  record Page, path : String, name : String, section : String, body : String, tables : Bool, footer : String, display : String do
    def render(date : String) : String
      String.build do |io|
        io << "'\\\" t\n" if tables
        io << ".\\\" " << display << '\n'
        io << ".\\\" " << MARKER << " from README.md and the doc comments; regenerate instead of editing.\n"
        io << ".TH " << Roff.quote(name) << ' ' << Roff.quote(section) << " \"" << date << "\" " << footer << '\n'
        io << body
      end
    end
  end

  # Builds every page of a shard: the overview and one page per documented type.
  class Pages
    # Superclasses every class or struct has, left out of declarations.
    IMPLICIT_SUPERCLASSES = {"Reference", "Struct"}

    # Member sections in page order: title, declaration keyword, members.
    MEMBER_SECTIONS = {
      {"CONSTRUCTORS", "def self.", ->(type : TypeDoc) { type.constructors }},
      {"CLASS METHODS", "def self.", ->(type : TypeDoc) { type.class_methods }},
      {"INSTANCE METHODS", "def ", ->(type : TypeDoc) { type.instance_methods }},
      {"MACROS", "macro ", ->(type : TypeDoc) { type.macros }},
    }

    @footer : String

    # *output* is the output directory as it appears in each page's path comment.
    def initialize(@shard : Shard, @index : Index, @output : String)
      source = [@shard.name, @shard.version].compact.join(' ')
      @footer = "#{Roff.quote(source)} #{Roff.quote("#{@shard.name} API Reference")}"
    end

    def all : Array(Page)
      [overview] + @index.types.map { |type| type_page(type) }
    end

    private def overview : Page
      blocks = Markdown.parse(@index.project.body)
      blocks.shift if (first = blocks.first?).is_a?(Markdown::Heading) && first.level == 1
      intro = blocks.take_while { |block| !(block.is_a?(Markdown::Heading) && block.level <= 2) }
      summary = intro.find(&.is_a?(Markdown::Paragraph)).as?(Markdown::Paragraph).try { |paragraph| ManPages.summary(paragraph.text) } || ""

      io = IO::Memory.new
      renderer = Markdown::Renderer.new(io, sections: true)
      section(io, "NAME")
      io << Roff.escape(@shard.name) << " \\- "
      io << (summary.empty? ? Roff.escape("#{@shard.name} API reference") : Markdown::Inline.render(summary, urls: false)) << '\n'
      unless intro.empty?
        section(io, "DESCRIPTION")
        renderer.render(intro)
      end
      renderer.render(blocks[intro.size..])

      section(io, "TYPES")
      @index.types.each do |type|
        summary = ManPages.summary(type.doc)
        io << ".TP\n.BR " << Roff.quote(page_name(type)) << " (" << TYPE_SECTION << SUFFIX << ")\n"
        io << (summary.empty? ? "\\&" : Markdown::Inline.render(summary)) << '\n'
      end
      page("man#{OVERVIEW_SECTION}/#{@shard.name}.#{OVERVIEW_SECTION}#{SUFFIX}", @shard.name, OVERVIEW_SECTION, io, renderer)
    end

    private def type_page(type : TypeDoc) : Page
      io = IO::Memory.new
      renderer = Markdown::Renderer.new(io)
      name = page_name(type)

      section(io, "NAME")
      summary = ManPages.summary(type.doc)
      io << Roff.escape(name) << " \\- "
      fallback = type.program? ? "top level methods, macros and constants of #{@shard.name}" : "#{type.kind} in #{@shard.name}"
      io << (summary.empty? ? Roff.escape(fallback) : Markdown::Inline.render(summary, urls: false)) << '\n'

      unless type.program?
        section(io, "SYNOPSIS")
        io << ".nf\n"
        @shard.require_path(type).try { |path| io << Roff.bold(%(require "#{path}")) << "\n.sp\n" }
        io << Roff.bold(declaration(type)) << "\n.fi\n"
      end

      unless (description = Markdown.parse(type.doc)).empty?
        section(io, "DESCRIPTION")
        renderer.render(description)
      end

      if explicit_superclass?(type)
        chain = [type.full_name] + type.ancestors.select(&.kind.in?("class", "struct")).map(&.full_name)
        section(io, "INHERITANCE")
        io << Roff.escape(chain.join(" < ")) << '\n'
      end

      type.relations.each do |title, refs|
        next if refs.empty?
        section(io, title)
        io << refs.join(",\n") { |ref| Roff.bold(ref.full_name) } << '\n'
      end

      constants(io, renderer, type)
      members(io, renderer, type)

      files = type.locations.compact_map(&.filename).uniq
      unless files.empty?
        section(io, "DEFINED IN")
        io << files.join("\n.br\n") { |file| Roff.escape(file) } << '\n'
      end

      see_also(io, type)
      page("man#{TYPE_SECTION}/#{name}.#{TYPE_SECTION}#{SUFFIX}", name, TYPE_SECTION, io, renderer)
    end

    private def constants(io : IO, renderer : Markdown::Renderer, type : TypeDoc) : Nil
      return if type.constants.empty?
      section(io, type.enum_type? ? "ENUM MEMBERS" : "CONSTANTS")
      type.constants.each do |constant|
        value = constant.value.try { |text| @shard.relative(text) }
        blocks = Markdown.parse(constant.doc)
        if value.nil? || Literal.inline?(value)
          tag = value ? "#{constant.name} = #{value}" : constant.name
        else
          tag = constant.name
          blocks.unshift(Markdown::Code.new("#{constant.name} = #{Literal.layout(value)}"))
        end
        entry(io, renderer, tag, blocks)
      end
    end

    private def members(io : IO, renderer : Markdown::Renderer, type : TypeDoc) : Nil
      MEMBER_SECTIONS.each do |title, keyword, list|
        members = list.call(type)
        next if members.empty?
        section(io, title)
        members.each do |member|
          entry(io, renderer, signature(type, keyword, member), Markdown.parse(member.doc))
        end
      end
    end

    # A bold *tag* with its documentation indented below it.
    private def entry(io : IO, renderer : Markdown::Renderer, tag : String, blocks : Array(Markdown::Block)) : Nil
      if blocks.empty?
        io << ".PP\n" << Roff.bold(tag) << '\n'
      else
        renderer.item(".TP #{Roff::INDENT}\n#{Roff.bold(tag)}", blocks)
      end
    end

    # Every related type with a page of its own, then the overview.
    private def see_also(io : IO, type : TypeDoc) : Nil
      related = [type.namespace, type.superclass].compact
      type.relations.each { |_, refs| related.concat(refs) }
      types = related.compact_map { |ref| @index[ref.full_name]? } + type.types + @index.referenced(type)
      names = types.map { |other| page_name(other) }.uniq.reject(page_name(type)).sort
      section(io, "SEE ALSO")
      names.each { |name| io << ".BR " << Roff.quote(name) << " (" << TYPE_SECTION << SUFFIX << "),\n" }
      io << ".BR " << Roff.quote(@shard.name) << " (" << OVERVIEW_SECTION << SUFFIX << ")\n"
    end

    private def declaration(type : TypeDoc) : String
      if type.alias_type? && (aliased = type.aliased)
        return "alias #{type.full_name} = #{ManPages.clean_type(aliased)}"
      end
      head = "#{"abstract " if type.abstract_type?}#{type.kind} #{type.full_name}"
      superclass = type.superclass
      superclass && explicit_superclass?(type) ? "#{head} < #{superclass.full_name}" : head
    end

    private def explicit_superclass?(type : TypeDoc) : Bool
      !!type.superclass.try { |superclass| !IMPLICIT_SUPERCLASSES.includes?(superclass.full_name) }
    end

    private def signature(type : TypeDoc, keyword : String, member : Member) : String
      keyword = "fun " if type.lib? && keyword != "macro "
      keyword = "def " if type.program? && keyword == "def self."
      "#{"abstract " if member.abstract_def?}#{keyword}#{member.name}#{member.parameters}"
    end

    private def page_name(type : TypeDoc) : String
      type.program? ? "#{@shard.name}-toplevel" : type.base_name
    end

    private def section(io : IO, title : String) : Nil
      io << ".SH " << Roff.quote(title) << '\n'
    end

    private def page(path : String, name : String, section : String, io : IO, renderer : Markdown::Renderer) : Page
      Page.new(path, name, "#{section}#{SUFFIX}", io.to_s, renderer.tables?, @footer, File.join(@output, path))
    end
  end

  # Writes pages into an output directory. A page whose content is unchanged keeps its file and date; generated
  # pages no longer produced are removed.
  class Generator
    TH_DATE = /\A\.TH "[^"]*" "[^"]*" "([^"]*)"/

    # Today, or the date of `SOURCE_DATE_EPOCH` for reproducible builds.
    def self.today : String
      epoch = ENV["SOURCE_DATE_EPOCH"]?
      time = epoch ? Time.unix(epoch.to_i64? || raise Error.new("invalid SOURCE_DATE_EPOCH `#{epoch}`")) : Time.local
      time.to_s("%Y-%m-%d")
    end

    def initialize(@output : String, @date : String)
    end

    # Writes *pages*; returns the numbers of pages written, unchanged and removed.
    def run(pages : Array(Page)) : {Int32, Int32, Int32}
      written = unchanged = 0
      pages.each do |page|
        file = File.join(@output, page.path)
        existing = File.file?(file) ? File.read(file) : nil
        if existing && !existing.includes?(MARKER)
          raise Error.new("#{file} was not generated by #{GENERATOR}; move it away first")
        end
        if existing && (date = date_of(existing)) && existing == page.render(date)
          unchanged += 1
        else
          Dir.mkdir_p(File.dirname(file))
          File.write(file, page.render(@date))
          written += 1
        end
      end
      {written, unchanged, remove_stale(pages.map { |page| File.join(@output, page.path) }.to_set)}
    end

    private def date_of(text : String) : String?
      text.each_line.find(&.starts_with?(".TH ")).try(&.match(TH_DATE)).try(&.[1])
    end

    private def remove_stale(keep : Set(String)) : Int32
      stale = Dir.glob(File.join(@output, "man*", "*")).select do |file|
        !keep.includes?(file) && File.file?(file) && File.read(file).includes?(MARKER)
      end
      stale.each { |file| File.delete(file) }
      stale.size
    end
  end

  # Copies generated pages into a manual directory and removes them again.
  module Installer
    # `$XDG_DATA_HOME/man`, by default `~/.local/share/man`, which `man` searches for a user with `~/.local/bin`
    # in `PATH`.
    def self.default_destination : String
      data = ENV["XDG_DATA_HOME"]?.presence || File.join(Path.home.to_s, ".local", "share")
      File.join(data, "man")
    end

    # Copies every page in *source* to *destination*; returns how many.
    def self.install(source : String, destination : String) : Int32
      pages = pages(source)
      pages.each do |page|
        target = File.join(destination, page)
        Dir.mkdir_p(File.dirname(target))
        File.copy(File.join(source, page), target)
        File.chmod(target, 0o644)
      end
      pages.size
    end

    # Removes from *destination* every generated page that *source* holds; returns how many.
    def self.uninstall(source : String, destination : String) : Int32
      pages(source).count do |page|
        target = File.join(destination, page)
        next false unless File.file?(target) && File.read(target).includes?(MARKER)
        File.delete(target)
        true
      end
    end

    # Pages in *source*, relative to it (`man3/Foo.3cr`).
    private def self.pages(source : String) : Array(String)
      pages = Dir.glob(File.join(source, "man*", "*")).select { |file| File.file?(file) }
      raise Error.new("no man pages in #{source}; run `generate` first") if pages.empty?
      pages.map { |file| Path[file].relative_to(source).to_s }.sort
    end
  end

  # Renders the pages of the shard in *root* into *output*; returns a report line.
  def self.generate(root : String, output : String) : String
    project = Source.load(root)
    shard = Shard.new(root, project.repository_name)
    shown = Path[output].relative_to?(root).try(&.to_s).try { |path| path.starts_with?("..") ? nil : path } || output
    pages = Pages.new(shard, Index.new(project), shown).all
    written, unchanged, removed = Generator.new(output, Generator.today).run(pages)
    "#{shown}: #{written} written, #{unchanged} unchanged, #{removed} removed"
  end

  # Command line entry point.
  module CLI
    # The shard this script belongs to.
    ROOT = File.expand_path("..", __DIR__)

    record Command, summary : String, action : Proc(String, String, String)

    COMMANDS = {
      "generate" => Command.new("Render README.md and the doc comments into the pages directory",
        ->(pages : String, _destination : String) { ManPages.generate(ROOT, pages) }),
      "install" => Command.new("Copy the pages into the manual directory",
        ->(pages : String, destination : String) { "#{Installer.install(pages, destination)} man pages installed in #{destination}" }),
      "uninstall" => Command.new("Remove the installed pages from the manual directory",
        ->(pages : String, destination : String) { "#{Installer.uninstall(pages, destination)} man pages removed from #{destination}" }),
    }

    def self.run(argv : Array(String)) : Nil
      pages = "man"
      destination = Installer.default_destination
      arguments = [] of String
      parser = OptionParser.new do |opts|
        opts.banner = banner
        opts.on("-o DIR", "--output=DIR", "Pages directory, relative to the shard root (default: man)") { |dir| pages = dir }
        opts.on("-d DIR", "--destination=DIR", "Manual directory (default: #{destination})") { |dir| destination = dir }
        opts.on("-h", "--help", "Print this help") { puts opts; exit }
        opts.invalid_option { |flag| raise Error.new("unknown option #{flag}") }
        opts.missing_option { |flag| raise Error.new("missing value for #{flag}") }
        opts.unknown_args { |before, after| arguments = before + after }
      end
      parser.parse(argv)

      raise Error.new("missing command\n#{parser}") if arguments.empty?
      raise Error.new("one command at a time, got: #{arguments.join(' ')}") if arguments.size > 1
      command = COMMANDS[arguments.first]? || raise Error.new("unknown command `#{arguments.first}`\n#{parser}")
      puts command.action.call(File.expand_path(pages, ROOT), File.expand_path(destination))
    rescue ex : Error | File::Error | IO::Error | JSON::ParseException | JSON::SerializableError
      STDERR.puts "#{GENERATOR}: #{ex.message}"
      exit 1
    end

    private def self.banner : String
      width = COMMANDS.keys.max_of(&.size)
      String.build do |io|
        io << "Usage: crystal run " << GENERATOR << " -- <command> [options]\n\nCommands:\n"
        COMMANDS.each { |name, command| io << "    " << name.ljust(width) << "  " << command.summary << '\n' }
        io << "\nOptions:"
      end
    end
  end
end

ManPages::CLI.run(ARGV)
